# Info
PROBLEM_NAME="lab3 problem3 - synchronous serial port"

# Sources (tb/ssptest.v is the professor's testbench, unmodified)
SOURCES="src/ssp_fifo.v src/ssp_tx.v src/ssp_rx.v src/ssp.v tb/ssptest.v"
TB_SOURCE="tb/ssp_tb.v"
TB_TOP="ssp_tb"

# Waveforms
VCD_FILE="sim/ssp_tb.vcd"
GTKW_SAVE="sim/ssp_tb.gtkw"

# GTKwave layout (test2 = loopback)
WAVES="
test2.clock test2.clear_b test2.psel test2.pwrite test2.data_in[7:0] test2.data_out[7:0]
-
test2.ssp2.SSPTXINTR test2.ssp2.tx_fifo.count[2:0]|dec test2.ssp2.tx_rd
-
test2.ssp2.SSPCLKOUT test2.ssp2.SSPFSSOUT test2.ssp2.SSPTXD test2.ssp2.SSPOE_B
test2.ssp2.tx.shreg[7:0] test2.ssp2.tx.bitcnt[2:0]|dec
-
test2.ssp2.rx.receiving test2.ssp2.rx.bitcnt[2:0]|dec test2.ssp2.rx.rx_data[7:0] test2.ssp2.rx_valid
-
test2.ssp2.SSPRXINTR test2.ssp2.rx_fifo.count[2:0]|dec
"
