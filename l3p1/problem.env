# Info
PROBLEM_NAME="lab3 problem1 - conditional sum adder"

# VHDL mode (compiled with vcom; VCD dumped by common/run.do)
HDL="vhdl"

# Sources
SOURCES="src/conditional_sum_block.vhd src/conditional_sum_adder.vhd"
TB_SOURCE="tb/conditional_sum_adder_tb.vhd"
TB_TOP="conditional_sum_adder_tb"

# Waveforms
VCD_FILE="sim/conditional_sum_adder_tb.vcd"
GTKW_SAVE="sim/conditional_sum_adder_tb.gtkw"

# GTKwave layout (VHDL: names must be lowercase)
WAVES="
cin
-
a[7:0]|dec b[7:0]|dec
-
sum[7:0]|dec cout
-
dut.c0 dut.c1
dut.s0[7:0]|dec dut.s1[7:0]|dec
"
