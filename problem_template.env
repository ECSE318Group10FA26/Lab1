# problem.env - per-problem configuration for ../sim.sh and ../wave.sh
#
# Every problem directory must contain this file.
# All paths are relative to the directory containing this file.

PROBLEM_NAME="problem1 - adder"

# Design sources, compiled in the order listed (space-separated).
SOURCES="src/adder.v"

# Optional: directories of shared library cells. Each directory's *.v
# files are appended to SOURCES (alphabetical order within a directory).
LIB_DIRS="../common/lib"

# Testbench file and its top-level module name (passed to vsim).
TB_SOURCE="tb/adder_tb.v"
TB_TOP="adder_tb"

# Waveform files. VCD_FILE must match the $dumpfile path in the testbench;
# GTKW_SAVE is an optional gtkwave layout file (pre-loaded if it exists).
VCD_FILE="sim/adder_tb.vcd"
GTKW_SAVE="sim/adder_tb.gtkw"

# gtkwave layout, regenerated by wave.sh: signals relative to TB_TOP,
# optional |hex or |dec radix (default hex); a lone "-" is a blank row.
WAVES="
clk clear load cin
-
addend[3:0]|dec augend[3:0]|dec
-
cout_s result_s[3:0]|dec
cout_b result_b[3:0]|dec
-
dut_structural.a_q[3:0]|dec dut_structural.b_q[3:0]|dec
dut_structural.sum_bit dut_structural.carry_d dut_structural.carry_q
"
