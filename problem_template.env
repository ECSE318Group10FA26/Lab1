# problem.env - per-problem configuration for ../sim.sh and ../wave.sh
#
# Every problem directory must contain this file.
# All paths are relative to the directory containing this file.

PROBLEM_NAME="problem1 - adder"

# HDL mode: "verilog" (default) or "vhdl". Verilog sources are compiled
# with vlog, VHDL sources with vcom (-2008).
HDL="verilog"

# VHDL only: logical libraries under ../common/lib/vhdl. Every directory
# containing *.vhd files maps to a library named by its path with '/'
# joined as '_' (util/tb -> util_tb)
# By default all libraries are compiled first (ordered by their
# cross-library 'library X;' references), so SOURCES may be empty when the
# design lives entirely in libraries. Set VHDL_LIBS to a space-separated
# list of directories relative to ../common/lib/vhdl (in dependency order)
# to compile only a subset. Within a library, files compile alphabetically
# unless the directory pins an order with a files.order file.
# VHDL_LIBS="util util/tb"

# Design sources, compiled in the order listed (space-separated).
SOURCES="src/adder.v"

# Optional: directories of shared library cells. Each directory's *.v
# (*.vhd in vhdl mode) files are appended to SOURCES (alphabetical order
# within a directory).
LIB_DIRS="../common/lib"

# Testbench file and its top-level module name (passed to vsim).
TB_SOURCE="tb/adder_tb.v"
TB_TOP="adder_tb"

# Waveform files. VCD_FILE must match the $dumpfile path in the testbench
# (in vhdl mode run.do dumps to this path instead); GTKW_SAVE is an
# optional gtkwave layout file (pre-loaded if it exists).
VCD_FILE="sim/adder_tb.vcd"
GTKW_SAVE="sim/adder_tb.gtkw"

# gtkwave layout, regenerated by wave.sh: signals relative to TB_TOP,
# optional |hex or |dec radix (default hex); a lone "-" is a blank row.
WAVES="
clk clear load cin
-
addend[3:0]|dec augend[3:0]|dec
-
cout_s result_s[3:0]|dec
cout_b result_b[3:0]|dec
-
dut_structural.a_q[3:0]|dec dut_structural.b_q[3:0]|dec
dut_structural.sum_bit dut_structural.carry_d dut_structural.carry_q
"
