# Info
PROBLEM_NAME="lab2 problem2 - simple CPU (cpu, ram, clk_gen)"

# Sources
SOURCES="src/cpu.v"
LIB_DIRS="../common/lib"

# Testbenches: cpu_tb (CPU running a program), ram_tb (ram + clk_gen)
# override from the environment, e.g.:  TB_NAME=ram_tb ./sim.sh l2p2
TB_NAME="${TB_NAME:-cpu_tb}"
TB_SOURCE="tb/$TB_NAME.v"
TB_TOP="$TB_NAME"

# Waveforms
VCD_FILE="sim/$TB_NAME.vcd"
GTKW_SAVE=""
