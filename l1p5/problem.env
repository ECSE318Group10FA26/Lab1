# Info
PROBLEM_NAME="problem5 - non-restoring divider loop"

# Sources
SOURCES="src/divider.v"
LIB_DIRS="../common/lib"
TB_SOURCE="tb/divider_tb.v"
TB_TOP="divider_tb"

# Waveforms
VCD_FILE="sim/divider_tb.vcd"
GTKW_SAVE="sim/divider_tb.gtkw"

# GTKwave layout (the N=4 instance, c_4, is the lab case)
#   Top: control handshake and the divider's inputs/outputs.
#   Middle: one-hot sequencer and the working registers M / R / D.
#   Bottom: the shared cas_row interface (pr in, sum + quotient-bit out).
WAVES="
c_4.clk c_4.rst c_4.start c_4.done
-
c_4.dividend[3:0]|dec c_4.divisor[3:0]|dec c_4.quotient[3:0]|dec c_4.remainder[4:0]|dec
-
c_4.dut.hot[3:0]|bin c_4.dut.M[3:0]|dec c_4.dut.R[4:0]|bin c_4.dut.D[3:0]|bin
-
c_4.dut.q_bit c_4.dut.pr[4:0]|bin c_4.dut.cas_sum[3:0]|bin c_4.dut.q_row
"
