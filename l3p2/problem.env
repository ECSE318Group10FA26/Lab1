# Info
PROBLEM_NAME="lab3 problem2 - long divider"

# VHDL mode (compiled with vcom; VCD dumped by common/run.do)
HDL="vhdl"

# Sources
SOURCES="src/long_divider.vhd"
TB_SOURCE="tb/long_divider_tb.vhd"
TB_TOP="long_divider_tb"

# Waveforms
VCD_FILE="sim/long_divider_tb.vcd"
GTKW_SAVE="sim/long_divider_tb.gtkw"

# GTKwave layout (VHDL: names must be lowercase)
WAVES="
clk c_4.clear c_4.start c_4.done
-
c_4.dividend[3:0]|dec c_4.divisor[3:0]|dec c_4.quotient[3:0]|dec c_4.remainder[3:0]|dec
-
c_4.dut.load c_4.dut.iter c_4.dut.corr c_4.dut.cnt[1:0]|dec
c_4.dut.m[3:0]|bin c_4.dut.r[4:0]|bin c_4.dut.d[3:0]|bin
-
c_4.dut.pr[4:0]|bin c_4.dut.r_pos c_4.dut.y[4:0]|bin c_4.dut.r_en
"
